{
  "name": "antiyoy-arena-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:wasm": "../scripts/build-wasm.sh",
    "stage:wasm": "cp lib/antiyoy-wasm/antiyoy_wasm_bg.wasm public/antiyoy_wasm_bg.wasm",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "stage:policy": "cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm public/ort-wasm-simd-threaded.wasm && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs public/ort-wasm-simd-threaded.mjs",
    "build": "npm run stage:wasm && npm run stage:policy && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && tsx --test tests/multiplayer-client.test.ts",
    "test:neural:live": "tsx --test tests/neural-runtime.test.ts",
    "test:multiplayer:live": "tsx --test tests/multiplayer-live.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern lib/antiyoy-wasm"
  },
  "dependencies": {
    "onnxruntime-web": "^1.23.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
